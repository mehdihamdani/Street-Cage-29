rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(playerId) {
      return isVerifiedUser() && request.auth.uid == playerId;
    }

    function isHexColor(val) {
      return val is string && val.size() == 7 && val.matches('^#[0-9a-fA-F]{6}$');
    }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll([
          'uid',
          'playerName',
          'jerseyColor',
          'bootColor',
          'totalScore',
          'goalsScored',
          'dribblesLanded',
          'ankleBreakers',
          'pannas',
          'matchesPlayed',
          'wins',
          'bestMatchScore',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'playerName',
          'jerseyColor',
          'bootColor',
          'totalScore',
          'goalsScored',
          'dribblesLanded',
          'ankleBreakers',
          'pannas',
          'matchesPlayed',
          'wins',
          'bestMatchScore',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.playerName is string
        && data.playerName.trim().size() >= 1
        && data.playerName.size() <= 32
        && isHexColor(data.jerseyColor)
        && isHexColor(data.bootColor)
        && data.totalScore is int
        && data.totalScore >= 0
        && data.goalsScored is int
        && data.goalsScored >= 0
        && data.dribblesLanded is int
        && data.dribblesLanded >= 0
        && data.ankleBreakers is int
        && data.ankleBreakers >= 0
        && data.pannas is int
        && data.pannas >= 0
        && data.matchesPlayed is int
        && data.matchesPlayed >= 0
        && data.wins is int
        && data.wins >= 0
        && data.wins <= data.matchesPlayed
        && data.bestMatchScore is int
        && data.bestMatchScore >= 0
        && data.bestMatchScore <= 30000
        && data.dribblesLanded == (data.ankleBreakers + data.pannas)
        && data.totalScore == ((data.goalsScored * 400) + (data.ankleBreakers * 250) + (data.pannas * 350))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isRecordMatchAction() {
      return incoming().diff(existing()).affectedKeys().hasOnly([
          'playerName',
          'jerseyColor',
          'bootColor',
          'totalScore',
          'goalsScored',
          'dribblesLanded',
          'ankleBreakers',
          'pannas',
          'matchesPlayed',
          'wins',
          'bestMatchScore',
          'updatedAt'
        ])
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().matchesPlayed == existing().matchesPlayed + 1
        && incoming().wins >= existing().wins
        && (incoming().wins - existing().wins) <= 1
        && incoming().goalsScored >= existing().goalsScored
        && (incoming().goalsScored - existing().goalsScored) <= 30
        && incoming().ankleBreakers >= existing().ankleBreakers
        && (incoming().ankleBreakers - existing().ankleBreakers) <= 40
        && incoming().pannas >= existing().pannas
        && (incoming().pannas - existing().pannas) <= 30
        && incoming().dribblesLanded >= existing().dribblesLanded
        && incoming().totalScore >= existing().totalScore
        && incoming().bestMatchScore >= existing().bestMatchScore
        && (incoming().bestMatchScore == existing().bestMatchScore || incoming().bestMatchScore == (incoming().totalScore - existing().totalScore))
        && (incoming().totalScore - existing().totalScore) <= 30000;
    }

    function isUpdateProfileAction() {
      return incoming().diff(existing()).affectedKeys().hasOnly([
          'playerName',
          'jerseyColor',
          'bootColor',
          'updatedAt'
        ])
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
    }

    match /leaderboard/{playerId} {
      allow get: if isValidId(playerId) && (resource == null || (existing().totalScore is int && existing().totalScore >= 0));
      allow list: if existing().totalScore >= 0;

      allow create: if isOwner(playerId)
        && isValidId(playerId)
        && isValidLeaderboardEntry(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().matchesPlayed <= 1
        && incoming().goalsScored <= 30
        && incoming().ankleBreakers <= 40
        && incoming().pannas <= 30
        && incoming().bestMatchScore == incoming().totalScore;

      allow update: if isOwner(playerId)
        && isValidId(playerId)
        && isValidLeaderboardEntry(incoming())
        && (isRecordMatchAction() || isUpdateProfileAction());

      allow delete: if false;
    }
  }
}
